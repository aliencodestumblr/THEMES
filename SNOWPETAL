@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&display=swap');

.tab-permalink-row {
  width: 100%;
  margin: 0 0 18px 0;
  padding: 6px 10px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #08080a !important;
  border: 1px solid #1e1e24;
  border-radius: 6px;
  box-sizing: border-box;
  font-family: 'Orbitron', sans-serif;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.tab-left,
.tab-right {
  display: flex;
  align-items: center;
  min-width: 0;
}

.tab-right {
  gap: 10px;
}

/* Base Link Styling */
.tab-permalink-row .tab-el {
  display: inline-flex !important;
  align-items: center !important;
  gap: 5px;
  text-decoration: none !important;
  font-size: 9px !important;
  font-weight: 700 !important;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: #888890 !important;
  background: transparent !important;
  border: none !important;
  transition: color 0.15s ease, text-shadow 0.15s ease;
  line-height: 1;
}

/* SVG Icon Handling */
.tab-permalink-row .tab-el svg {
  width: 11px !important;
  height: 11px !important;
  fill: none !important;
  stroke: currentColor !important;
  stroke-width: 2.2px !important;
  stroke-linecap: round;
  stroke-linejoin: round;
  transition: transform 0.15s ease, stroke 0.15s ease;
}

/* Hover States */
.tab-permalink-row .tab-el:hover {
  color: #ffffff !important;
  text-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
}

.tab-permalink-row .tab-el:hover svg {
  stroke: #ffffff !important;
  transform: scale(1.08);
}

/* Left Pill Highlight for Note Count */
.tab-left .tab-el {
  padding: 4px 8px !important;
  background: rgba(255, 255, 255, 0.04) !important;
  border: 1px solid #2a2a32 !important;
  border-radius: 4px;
  color: #ffffff !important;
}

.tab-left .tab-el:hover {
  background: #ffffff !important;
  border-color: #ffffff !important;
  color: #000000 !important;
  text-shadow: none !important;
}

.tab-left .tab-el:hover svg {
  stroke: #000000 !important;
}

/* Separator Styling */
.tab-right .tab-sep {
  color: #272730;
  font-size: 10px;
  font-weight: 700;
  user-select: none;
}

/* Remove default theme pseudoelements */
.tab-el::before,
.tab-el::after {
  display: none !important;
}

