<!-- ================= SCRIPT ================= -->
<script>
document.addEventListener('DOMContentLoaded', function() {

  /* ---------------------------------------------------
     1. NAV MENU TOGGLE (3D FLIP CHAMBER & OVERLAY FALLBACK)
     --------------------------------------------------- */
  var toggleBtn = document.getElementById('sidebarMenuToggleBtn');
  var displayChamber = document.getElementById('displayChamber');
  var menuOverlay = document.getElementById('sidebarNavOverlay');
  var iconSpan = document.getElementById('btnMenuIcon');

  // Unified SVG Icon Templates (24x24 viewBox matching the initial HTML)
  var hamburgerIcon = '<svg viewBox="0 0 24 24" class="sidebar-svg-icon"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>';
  var closeIcon = '<svg viewBox="0 0 24 24" class="sidebar-svg-icon"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';

  if (toggleBtn) {
    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();

      // 3D Chamber flip support
      if (displayChamber) {
        displayChamber.classList.toggle('is-flipped');
      }

      // Traditional overlay toggle support
      if (menuOverlay) {
        menuOverlay.classList.toggle('is-open');
      }

      // Update SVG icon dynamically using identical viewbox coordinates
      if (iconSpan) {
        var isOpen = (displayChamber && displayChamber.classList.contains('is-flipped')) ||
                     (menuOverlay && menuOverlay.classList.contains('is-open'));
        iconSpan.innerHTML = isOpen ? closeIcon : hamburgerIcon;
      }
    });
  }

  /* ---------------------------------------------------
     2. ASK POPUP MODAL
     --------------------------------------------------- */
  var openAsk = document.getElementById('openAskBtn');
  var closeAsk = document.getElementById('closeAskModal');
  var askModal = document.getElementById('askModalOverlay');

  if (openAsk && askModal) {
    openAsk.addEventListener('click', function(e) {
      e.preventDefault();
      askModal.classList.add('is-active');
      askModal.setAttribute('aria-hidden', 'false');
    });
  }

  if (closeAsk && askModal) {
    closeAsk.addEventListener('click', function(e) {
      e.preventDefault();
      askModal.classList.remove('is-active');
      askModal.setAttribute('aria-hidden', 'true');
    });

    // Close when clicking directly on background overlay
    askModal.addEventListener('click', function(e) {
      if (e.target === askModal) {
        askModal.classList.remove('is-active');
        askModal.setAttribute('aria-hidden', 'true');
      }
    });
  }

  /* ---------------------------------------------------
     3. AUDIO PLAYER SCRIPT FOR 5 TRACKS
     --------------------------------------------------- */
  var audio = document.getElementById('acMiniAudio');
  var playBtn = document.getElementById('acMiniToggle');
  var nextBtn = document.getElementById('sbNext');
  var trackName = document.getElementById('sbTrackName');
  var trackArtist = document.getElementById('sbTrackArtist');
  var playlistBtns = Array.from(document.querySelectorAll('#sbPlaylist .sb-song'));

  // Build tracks with fallback logic for direct MP3s / Tumblr theme variables
  var playlist = playlistBtns.map(function(btn) {
    var rawSrc = btn.getAttribute('data-src');
    var rawTitle = btn.getAttribute('data-title');
    var rawArtist = btn.getAttribute('data-artist');

    return {
      element: btn,
      src: (rawSrc && !rawSrc.includes('{text:')) ? rawSrc : btn.getAttribute('data-default-src'),
      title: (rawTitle && !rawTitle.includes('{text:')) ? rawTitle : btn.getAttribute('data-default-title'),
      artist: (rawArtist && !rawArtist.includes('{text:')) ? rawArtist : btn.getAttribute('data-default-artist')
    };
  });

  var currentIndex = 0;

  function loadTrack(index) {
    if (playlist.length === 0 || !playlist[index]) return;

    var track = playlist[index];
    if (audio && track.src) {
      audio.src = track.src;
      if (trackName) trackName.textContent = track.title || 'Unknown Track';
      if (trackArtist) trackArtist.textContent = track.artist || 'Unknown Artist';

      // Update active highlight classes on the playlist UI
      playlist.forEach(function(item, i) {
        if (item.element) {
          item.element.classList.toggle('is-active', i === index);
        }
      });
    }
  }

  // Click on playlist items directly to switch track
  playlist.forEach(function(item, index) {
    if (item.element) {
      item.element.addEventListener('click', function(e) {
        e.preventDefault();
        currentIndex = index;
        loadTrack(currentIndex);
        if (audio) {
          audio.play().then(function() {
            if (playBtn) playBtn.classList.add('is-playing');
          }).catch(function(err) {
            console.log("Audio play error:", err);
          });
        }
      });
    }
  });

  // Initialize first track
  if (playlist.length > 0) {
    loadTrack(0);
  }

  // Play / Pause toggle button
  if (playBtn && audio) {
    playBtn.addEventListener('click', function(e) {
      e.preventDefault();

      if (audio.paused) {
        audio.play().then(function() {
          playBtn.classList.add('is-playing');
        }).catch(function(err) {
          console.log("Audio play error:", err);
        });
      } else {
        audio.pause();
        playBtn.classList.remove('is-playing');
      }
    });
  }

  // Next track button
  if (nextBtn && playlist.length > 0) {
    nextBtn.addEventListener('click', function(e) {
      e.preventDefault();
      currentIndex = (currentIndex + 1) % playlist.length;
      loadTrack(currentIndex);
      if (audio) {
        audio.play().then(function() {
          if (playBtn) playBtn.classList.add('is-playing');
        }).catch(function(err) {
          console.log("Audio play error:", err);
        });
      }
    });
  }

  // Auto-play next track when current ends
  if (audio) {
    audio.addEventListener('ended', function() {
      if (playlist.length > 0) {
        currentIndex = (currentIndex + 1) % playlist.length;
        loadTrack(currentIndex);
        audio.play().then(function() {
          if (playBtn) playBtn.classList.add('is-playing');
        });
      }
    });
  }

});
</script>

