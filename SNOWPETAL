/* --- Ask Card (Pastel Frosted Bubble) --- */
.ask-card {
  position: relative;
  width: 100%;
  padding: 20px 22px;

  /* Frosted Glass + Soft Gradient Background */
  background: linear-gradient(
    135deg,
    rgba(255, 255, 255, 0.85) 0%,
    rgba(245, 238, 255, 0.7) 50%,
    rgba(255, 235, 243, 0.75) 100%
  );
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  /* Marshmallow curves & floating aura shadow */
  border-radius: 26px;
  border-bottom-left-radius: 8px;
  border: 1.5px solid rgba(255, 255, 255, 0.9);
  box-shadow: 
    0 12px 30px -8px rgba(210, 185, 225, 0.25),
    inset 0 2px 4px rgba(255, 255, 255, 0.9);

