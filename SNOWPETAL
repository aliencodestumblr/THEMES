  justify-content: space-between;
  margin-bottom: 14px;
}

.asker-info {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Pastel Avatar Aura Ring */
.asker-avatar-ring {
  padding: 2px;
  background: linear-gradient(135deg, #ffd1dc, #d8b4fe, #bae6fd);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(216, 180, 254, 0.3);
