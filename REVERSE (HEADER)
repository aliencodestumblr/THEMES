itle}</h2>{/block:Title} <ul class="chat"> {block:Lines}<li class="{Alt}">{block:Label}<strong>{Label}</strong>{/block:Label} {Line}</li>{/block:Lines} </ul> {/block:Chat} {block:Audio} {AudioEmbed} {block:Caption}<div class="caption">{Caption}</div>{/block:Caption} {/block:Audio} {block:Video} {Video-500} {block:Caption}<div class="caption">{Caption}</div>{/block:Caption} {/block:Video} 
