<script>
$(document).ready(function(){

  var $posts = $('#posts');
  var $next = $('#next');

  if (!$posts.length || !$next.length) return;

  var loading = false;
  var finished = false;

  function loadMore(){

    if (loading || finished) return;

    var url = $next.attr('href');

    if (!url) {
      finished = true;
      return;
    }

    loading = true;

    $.get(url, function(data){

      var $page = $(data);
      var $newPosts = $page.find('#posts > article.posts');

      if (!$newPosts.length) {
        finished = true;
        loading = false;
        return;
      }

      /* Get the next page BEFORE adding anything */
      var newNext = $page.find('#next').attr('href');

      /* Add the new posts */
      $newPosts.each(function(){
        $posts.append(this);
      });

      /* Update pagination */
      if (newNext) {
        $next.attr('href', newNext);
      } else {
        finished = true;
      }

      /* Let Tumblr/theme scripts recalculate the page */
      $(window).trigger('resize');

      setTimeout(function(){
        $(window).trigger('resize');
      }, 250);

      loading = false;

    }).fail(function(){

      console.log('[aliencodes] Infinite Scroll request failed.');
      loading = false;

    });
  }

  $(window).on('scroll.aliencodesInfinite', function(){

    if (loading || finished) return;

    var scrollTop = $(window).scrollTop();
    var windowHeight = $(window).height();
    var documentHeight = $(document).height();

    if (scrollTop + windowHeight >= documentHeight - 1200){
      loadMore();
    }

  });

});
</script>
{/block:IfNotPagination}
{/block:IndexPage}


<script>
document.addEventListener("DOMContentLoaded", function(){

  var audio = document.getElementById("acMiniAudio");
  var toggle = document.getElementById("acMiniToggle");
  var icon = document.getElementById("acMiniIcon");
  var next = document.getElementById("sbNext");
  var title = document.getElementById("sbTrackName");
  var artist = document.getElementById("sbTrackArtist");
  var songs = [].slice.call(document.querySelectorAll("#sbPlaylist .sb-song"));

  if(!audio || !toggle || !icon || !songs.length) return;

  var index = 0;

  /* OUTLINED PLAY ICON */
  var playIcon =
    '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">' +
      '<polygon points="8,5 19,12 8,19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>' +
    '</svg>';

  /* OUTLINED SQUARE STOP ICON */
  var stopIcon =
    '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">' +
      '<rect x="5.5" y="5.5" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7"/>' +
    '</svg>';

  function loadSong(i){
    index = i;
    var song = songs[index];

    audio.src = song.dataset.src;

    if(title) title.innerHTML = song.dataset.title || "untitled";
    if(artist) artist.innerHTML = song.dataset.artist || "unknown";
  }

  function showPlaying(){
    icon.innerHTML = stopIcon;
    toggle.classList.add("is-playing");
  }

  function showPaused(){
    icon.innerHTML = playIcon;
    toggle.classList.remove("is-playing");
  }

  toggle.addEventListener("click", function(e){
    e.preventDefault();
    e.stopPropagation();

    if(!audio.src) loadSong(index);

    if(audio.paused){
      audio.play();
    } else {
      audio.pause();
    }
  });

  if(next){
    next.addEventListener("click", function(e){
      e.preventDefault();
      e.stopPropagation();

      index = (index + 1) % songs.length;
      loadSong(index);
      audio.play();
    });
  }

  audio.addEventListener("play", showPlaying);

  audio.addEventListener("pause", showPaused);

  audio.addEventListener("ended", function(){
    index = (index + 1) % songs.length;
    loadSong(index);
    audio.play();
  });

  loadSong(0);
  showPaused();

});
</script>



