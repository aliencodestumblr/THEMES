<script>
(function () {

  function initializeFixedHeader() {

    var header = document.getElementById('sidebar');

    if (!header) {
      return;
    }


    function updateHeader() {

      var scrollPosition =
        window.pageYOffset ||
        document.documentElement.scrollTop ||
        document.body.scrollTop ||
        0;


      if (scrollPosition > 45) {

        if (!header.classList.contains('is-scrolled')) {
          header.classList.add('is-scrolled');
        }

      } else {

        if (header.classList.contains('is-scrolled')) {
          header.classList.remove('is-scrolled');
        }

      }

    }


    window.addEventListener(
      'scroll',
      updateHeader,
      {
        passive: true
      }
    );


    window.addEventListener(
      'resize',
      updateHeader,
      {
        passive: true
      }
    );


    updateHeader();

  }


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initializeFixedHeader
    );

  } else {

    initializeFixedHeader();

  }

})();
</script>

<script>
  function enforceAvatarStyles() {
    $('.post-avatar-col, .post-avatar-col a').css({
      'width': '18px',
      'height': '18px',
      'border-radius': '50%',
      'overflow': 'hidden',
      'display': 'block'
    });

    $('.post-avatar-col img').css({
      'width': '18px',
      'height': '18px',
      'min-width': '18px',
      'min-height': '18px',
      'max-width': '18px',
      'max-height': '18px',
      'border-radius': '50%',
      'object-fit': 'cover',
      'display': 'block'
    });
  }

  $(document).ready(function() {
    enforceAvatarStyles();
    
    // Watch for dynamic/infinite scroll post loading
    var observer = new MutationObserver(enforceAvatarStyles);
    var postsContainer = document.getElementById('posts');
    if (postsContainer) {
      observer.observe(postsContainer, { childList: true, subtree: true });
    }
  });
</script>

