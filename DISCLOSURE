.princess-menu {
    position: relative;
    display: block;
    width: 100%;
    margin: 8px -1px 0;
    padding: 0;
    text-align: right;
}

.princess-menu-toggle {
    appearance: none;
    -webkit-appearance: none;

    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;

    width: auto;
    min-height: 20px;
