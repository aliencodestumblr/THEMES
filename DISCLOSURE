}

.video{
  width:100%;
  {block:permalinkpage}
  width:100%;
  {/block:permalinkpage}
}

.vsanna{ display:none; }


/* ---------------- ROLAGEM INFINITA ---------------- */
#infscr-loading{
  position:absolute;
  bottom:0;
  margin-left:50%;
  left:0px;
  text-align:center;
}

#infscr-loading img{
  display:none;
  width:20px;
  height:20px;
}


/* EFEITO DE CARREGAMENTO SUAVE */
{block:IndexPage}
.posts{
  transition: opacity .75s ease, transform .75s ease;
}

.posts.is-ready{
  opacity:1;
  transform: translateY(0);
}
{/block:IndexPage}
