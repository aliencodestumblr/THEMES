/* ---------------- POST CONTAINER ---------------- */

.entry {
  width: 340px;
  height: auto;
  margin: 0 auto !important;

  {block:PermalinkPage}
  width: 340px;
  border-radius: 12px;
  margin: 0 auto !important;
  {/block:PermalinkPage}
}

#posts {
  width: 340px;
  margin: 20px auto 50px auto !important;
  transform: translateX(30px);

  transition: opacity 0s, filter 0s;

  {block:PermalinkPage}
  width: 340px;
  margin: 47px auto 0 auto !important;
  transform: translateX(45px);
  border: 0;
  {/block:PermalinkPage}
}

/* ---------------- POST CARDS ---------------- */

.posts {
  box-sizing: border-box;
  width: 340px;
  margin: 15px;
  margin-bottom: 35px;
  padding: 11px;

  overflow: hidden;
  opacity: 1;

  background: #fff;

  transition:
    opacity .45s ease,
    transform .45s ease,
    box-shadow .28s ease;

  {block:PermalinkPage}
  width: 340px;
  margin: 15px auto 0 auto;
  padding: 0;

  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  {/block:PermalinkPage}
}

/* ---------------- POST MEDIA ---------------- */

.posts img,
.posts video,
.posts iframe {
  max-width: 100%;
}

{block:PermalinkPage}
#posts .posts img {
  border-radius: 0;
}
{/block:PermalinkPage}

/* ---------------- LINHA DO USUÁRIO NO TOPO DO POST ---------------- */
