@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap');

:root {
    --sb-width: 190px;
    --sb-gap: 35px;
    --sb-avatar: 70px;
    --sb-ink: {color:text};
    --sb-muted: #999;
}

.princess-sidebar {
    position: fixed;
    z-index: 9990;

    right: calc(50% + 200px);
    top: 30%;
    transform: translateY(-50%);

    width: var(--sb-width);
    margin: 0;
    padding: 0;

    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;

    box-sizing: border-box;
    overflow: visible;

    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    color: var(--sb-ink);
    font-family: 'Rajdhani', sans-serif;
    text-align: right;
}

.princess-avatar-wrap {
    display: flex;
    justify-content: flex-end;
    width: 100%;
    margin: 0 0 17px;
}

.princess-avatar {
    position: relative;
    isolation: isolate;

    display: block;
    width: var(--sb-avatar);
    height: var(--sb-avatar);
    flex: 0 0 var(--sb-avatar);

    border-radius: 50%;
    text-decoration: none;
    box-sizing: border-box;
}

.princess-avatar img {
    position: absolute;
    inset: 0;
    z-index: 2;

    display: block;
    width: 100%;
    height: 100%;

    object-fit: cover;
    border: none;
    border-radius: 50%;

    transition: filter .35s ease;
}

.princess-avatar-ring {
    position: absolute;
    inset: -5px;
    z-index: 1;

    box-sizing: border-box;
    border: 1px solid transparent;
    border-radius: 50%;

    background:
        linear-gradient(transparent, transparent) padding-box,
        conic-gradient(
            from 0deg,
            transparent 0deg,
            rgba(0,0,0,.08) 35deg,
            rgba(0,0,0,.78) 105deg,
            rgba(150,150,150,.3) 155deg,
            transparent 215deg,
            rgba(0,0,0,.6) 290deg,
            transparent 360deg
        ) border-box;

    animation: sb-orbit 9s linear infinite;
    opacity: .8;
    pointer-events: none;
}

.princess-avatar-ring::after {
    content: "";
    position: absolute;
    inset: 4px;

    border: 1px dashed rgba(0,0,0,.15);
    border-radius: 50%;
}

.princess-avatar:hover img {
    filter: grayscale(100%) contrast(1.08);
}

.princess-avatar:hover .princess-avatar-ring {
    opacity: 1;
}

@keyframes sb-orbit {
    to { transform: rotate(360deg); }
}

.desc-nexus-header {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;

    background: transparent;
    border: none;
    text-align: right;
}

.desc-nexus-title {
    position: relative;
    display: inline-block;
    max-width: 100%;

    margin: 0 0 10px;
    padding: 0;

    color: var(--sb-ink);
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.1px;
    line-height: 1.6;
    text-transform: uppercase;
    overflow-wrap: anywhere;

    isolation: isolate;
    animation: sb-flicker 5s infinite steps(1, end);
}

.desc-nexus-title::before,
.desc-nexus-title::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;

    color: var(--sb-ink);
    background: transparent;
    pointer-events: none;
}

.desc-nexus-title::before {
    animation: sb-glitch-one 4s infinite;
}

.desc-nexus-title::after {
    animation: sb-glitch-two 3.7s infinite;
}

@keyframes sb-glitch-one {
    0%, 91%, 94%, 100% {
        clip-path: inset(0 0 0 0);
        transform: translateX(0);
    }
    92% {
        clip-path: inset(12% 0 70% 0);
        transform: translateX(-2px);
    }
    93% {
        clip-path: inset(55% 0 20% 0);
        transform: translateX(2px);
    }
}

@keyframes sb-glitch-two {
    0%, 84%, 88%, 100% {
        clip-path: inset(0 0 0 0);
        transform: translateX(0);
    }
    85% {
        clip-path: inset(65% 0 10% 0);
        transform: translateX(2px);
    }
    86% {
        clip-path: inset(25% 0 45% 0);
        transform: translateX(-1px);
    }
}

@keyframes sb-flicker {
    0%, 96%, 98%, 100% { opacity: 1; }
    97% { opacity: .8; }
}

