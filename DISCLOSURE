    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.7px;
    line-height: 1.5;
    text-transform: uppercase;

    cursor: pointer;
    transition: opacity .25s ease;
}

.princess-menu-toggle::before {
    content: "+";
    display: inline-block;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.9;
    transition: transform .3s ease;
}

.princess-menu-toggle:hover {
    opacity: .55;
}

.princess-menu.is-open .princess-menu-toggle::before {
    transform: rotate(45deg);
}

.princess-menu-panel {
    position: absolute;
    z-index: 99999;

    top: calc(100% + 9px);
    right: 0;
    left: auto;

    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;

    width: max-content;
    min-width: 100%;
    max-width: 220px;
    max-height: 0;

    margin: 0 !important;
    padding: 0;

    box-sizing: border-box;
    overflow: hidden;

    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    visibility: hidden;
    opacity: 0;
    pointer-events: none;

    clip-path: inset(0 0 100% 0);
    transform: translateY(-7px);

    transition:
        max-height .45s cubic-bezier(.22, 1, .36, 1),
        opacity .25s ease,
        transform .4s cubic-bezier(.22, 1, .36, 1),
        clip-path .4s ease,
        visibility .4s ease;
}

.princess-menu:hover .princess-menu-panel,
.princess-menu:focus-within .princess-menu-panel,
.princess-menu.is-open .princess-menu-panel {
    max-height: 260px;

    visibility: visible;
    opacity: 1;
    pointer-events: auto;

    clip-path: inset(0 0 0 0);
    transform: translateY(0);
}

.princess-menu-panel a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;

    min-height: 27px;
    max-width: 100%;
    margin: 0;
    padding: 0;

    color: var(--sb-ink) !important;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;

    font-family: 'Rajdhani', sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.25px;
    line-height: 1.5;
    text-align: right;
    text-transform: uppercase;
    text-decoration: none;

    transition:
        opacity .2s ease,
        letter-spacing .25s ease,
        transform .25s ease;
}

.princess-menu-panel a span {
    order: 1;
}

.princess-menu-panel a i {
    order: 2;
    color: var(--sb-muted);
    font-size: 12px;
}

.princess-menu-panel a:hover {
    opacity: .55;
    letter-spacing: 1.7px;
    transform: translateX(-2px);
}

.princess-menu {
    position: relative;
}

.princess-menu::after {
    content: "";
    position: absolute;
    top: 100%;
    right: 0;

    width: 100%;
    height: 14px;

    background: transparent;
}

.princess-menu-panel {
    top: 100%;
