<script>
(function () {
    "use strict";

    function initAlienStatusPill() {
        const pill = document.getElementById("acStatusPill");
        const countElement = document.getElementById("acOnlineCount");
        const clockElement = document.getElementById("acLocalClock");

        if (!pill || !countElement || !clockElement) return;

        /* Prevent duplicate initialization */
        if (pill.dataset.acInitialized === "true") return;
        pill.dataset.acInitialized = "true";

        /* SETTINGS */
        const MIN_ONLINE = 8;
        const MAX_ONLINE = 24;
        const COUNT_CHANGE_MIN = 7000;
        const COUNT_CHANGE_MAX = 16000;
        const VIEW_DURATION = 4500;

        let onlineCount = Math.floor(
            Math.random() * (MAX_ONLINE - MIN_ONLINE + 1)
        ) + MIN_ONLINE;

        let showingClock = false;
        let transitionTimer = null;
        let countTimer = null;

        /* Update the simulated online count */
        function updateOnlineCount() {
            const change = Math.floor(Math.random() * 5) - 2;

            onlineCount = Math.max(
                MIN_ONLINE,
                Math.min(MAX_ONLINE, onlineCount + change)
            );

            countElement.textContent = onlineCount;

            scheduleCountChange();
        }

        /* Random interval between count changes */
        function scheduleCountChange() {
            clearTimeout(countTimer);

            const delay = COUNT_CHANGE_MIN +
                Math.random() *
                (COUNT_CHANGE_MAX - COUNT_CHANGE_MIN);

            countTimer = setTimeout(updateOnlineCount, delay);
        }

        /* Update the visitor's local time */
        function updateLocalClock() {
            const now = new Date();

            clockElement.textContent = now.toLocaleTimeString([], {
                hour: "numeric",
                minute: "2-digit",
                hour12: true
            });
        }

        /* Alternate between online status and clock */
        function cycleViews() {
            showingClock = !showingClock;

            pill.classList.toggle("ac-show-clock", showingClock);

            const onlineView = pill.querySelector(".ac-status-online");
            const clockView = pill.querySelector(".ac-status-clock");

            if (onlineView && clockView) {
                onlineView.setAttribute(
                    "aria-hidden",
                    String(showingClock)
                );

                clockView.setAttribute(
                    "aria-hidden",
                    String(!showingClock)
                );
            }

            transitionTimer = setTimeout(cycleViews, VIEW_DURATION);
        }

        /* Initialize */
        updateLocalClock();

        countElement.textContent = onlineCount;

        scheduleCountChange();

        /* Keep the clock accurate */
        setInterval(updateLocalClock, 1000);

        /* Begin with online status, then transition */
        transitionTimer = setTimeout(cycleViews, VIEW_DURATION);

        /* Clean up if the theme removes the pill */
        window.addEventListener("pagehide", function () {
            clearTimeout(transitionTimer);
            clearTimeout(countTimer);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            initAlienStatusPill,
            { once: true }
        );
    } else {
        initAlienStatusPill();
    }
})();
</script>

<script>
(function () {
    function initAskPopup() {
        const popup = document.getElementById("popup-ask");
        const overlay = document.getElementById("fade-ask");

        if (!popup || !overlay) {
            console.error("Ask popup: popup or overlay HTML not found.");
            return;
        }

        if (popup.dataset.askReady === "true") return;
        popup.dataset.askReady = "true";

        const closeButton = popup.querySelector(".ask-close");

        function openAsk(event) {
            event.preventDefault();

            popup.classList.add("is-visible");
            overlay.classList.add("is-visible");

            popup.setAttribute("aria-hidden", "false");
            overlay.setAttribute("aria-hidden", "false");

            document.body.style.overflow = "hidden";
        }

        function closeAsk() {
            popup.classList.remove("is-visible");
            overlay.classList.remove("is-visible");

            popup.setAttribute("aria-hidden", "true");
            overlay.setAttribute("aria-hidden", "true");

            document.body.style.overflow = "";
        }

        document.addEventListener("click", function (event) {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const askLink = target.closest(
                ".snake-menu-panel a.poplight, " +
                ".snake-menu-panel a[href*='ask'], " +
                "a.poplight, " +
                "[data-open-ask]"
            );

            if (askLink) {
                openAsk(event);
            }
        });

        if (closeButton) {
            closeButton.addEventListener("click", closeAsk);
        }

        overlay.addEventListener("click", closeAsk);

        document.addEventListener("keydown", function (event) {
            if (
                event.key === "Escape" &&
                popup.classList.contains("is-visible")
            ) {
                closeAsk();
            }
        });

        console.log("Ask popup script loaded.");
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAskPopup);
    } else {
        initAskPopup();
    }
})();
</script>

<script>
(function () {
    function initPrincessSidebar() {
        const sidebar = document.getElementById("princessSidebar");

        if (!sidebar || sidebar.dataset.initialized === "true") {
            return;
        }

        sidebar.dataset.initialized = "true";

        const menu = sidebar.querySelector(".princess-menu");
        const menuButton = document.getElementById("princessMenuToggle");

        if (!menu || !menuButton) return;

        menuButton.addEventListener("click", function () {
            const isOpen = menu.classList.toggle("is-open");

            menuButton.setAttribute("aria-expanded", String(isOpen));
            menuButton.setAttribute(
                "aria-label",
                isOpen ? "Fechar menu" : "Abrir menu"
            );

            const icon = menuButton.querySelector("i");

            if (icon) {
                icon.className = isOpen ? "ph ph-x" : "ph ph-list";
            }
        });

        /* Close the menu when clicking outside the sidebar */
        document.addEventListener("click", function (event) {
            if (!sidebar.contains(event.target)) {
                menu.classList.remove("is-open");
                menuButton.setAttribute("aria-expanded", "false");
                menuButton.setAttribute("aria-label", "Abrir menu");

                const icon = menuButton.querySelector("i");

                if (icon) {
                    icon.className = "ph ph-list";
                }
            }
        });

        /* Close the menu after selecting a navigation link */
        menu.querySelectorAll(".princess-menu-panel a").forEach(function (link) {
            link.addEventListener("click", function () {
                menu.classList.remove("is-open");
                menuButton.setAttribute("aria-expanded", "false");
                menuButton.setAttribute("aria-label", "Abrir menu");

                const icon = menuButton.querySelector("i");

                if (icon) {
                    icon.className = "ph ph-list";
                }
            });
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initPrincessSidebar);
    } else {
        initPrincessSidebar();
    }
})();
</script>

<script>
(function () {
    function startMusicPlayer() {
