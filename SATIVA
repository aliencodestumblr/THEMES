<script>
(function($){
  if(!window.jQuery) return;

  var $win = $(window);
  var $container = $('#posts');
  if(!$container.length) return;

  if($container.data('acInitDone') === 1) return;
  $container.data('acInitDone', 1);

  var layoutTimer = null;
  var scanTimer = null;
  var mutationObserver = null;

  // Clear legacy styles and inject structural positioning + the media post header hide rule
  $('#ac-hover-script-safety, #ac-single-script-safety, #ac-clean-top-permalink-style, #ac-final-single-style, #ac-final-masonry-style, #ac-masonry-structural-style').remove();

  $('<style id="ac-masonry-structural-style">' +
    '#posts { position: relative !important; }' +
    '#posts > .posts { position: absolute; z-index: 1; box-sizing: border-box; }' +
    '.posts.ac-prep { visibility: hidden !important; opacity: 0 !important; pointer-events: none !important; z-index: -1 !important; }' +
    '.posts.is-ready { visibility: visible; opacity: 1; pointer-events: auto; }' +
    '.ac-media-post .post-top { display: none !important; }' + 
  '</style>').appendTo('head');

  function safe(fn){ try{ fn(); }catch(e){} }

  function throttle(fn, wait){
    var t = null;
    return function(){
      if(t) return;
      t = setTimeout(function(){
        t = null;
        fn();
      }, wait);
    };
  }

  function scopePosts($scope){
    $scope = ($scope && $scope.length) ? $scope : $(document);
    return $scope.filter('.posts').add($scope.find('.posts'));
  }

  // Detects if a post contains photo/video elements to separate text from media
  function hasMedia($post){
    if(!$post || !$post.length) return false;

    if($post.find('.photo-slideshow,.media-wrap,.npf_photoset,.npf_grid,.npf_container,.npf_group,.npf_row,.npf_col,.npf_image,.tmblr-full,figure.tmblr-full,.npf_video_container,.npf_video,video').length){
      return true;
    }

    return $post.find('img,iframe').filter(function(){
      var $el = $(this);
      if($el.closest('#sidebar,#topbar,.cc,#ltop,.sb-card,.brand-icon').length) return false;

      var src = (
        $el.attr('src') ||
        $el.attr('srcset') ||
        $el.attr('data-src') ||
        ''
      ).toLowerCase();

      return (
        src.indexOf('media.tumblr.com') !== -1 ||
        src.indexOf('64.media.tumblr.com') !== -1 ||
        src.indexOf('va.media.tumblr.com') !== -1 ||
        src.indexOf('tumblr.com/video') !== -1 ||
        src.indexOf('youtube.com') !== -1 ||
        src.indexOf('vimeo.com') !== -1
      );
    }).length > 0;
  }

  function initPhotosets($scope){
    $scope = ($scope && $scope.length) ? $scope : $(document);
    if(!$.fn.pxuPhotoset) return;

    $scope.find('.photo-slideshow').each(function(){
      if(this._acPXUInited) return;
      this._acPXUInited = true;

      $(this).pxuPhotoset({
        lightbox:true,
        rounded:false,
        gutter:'1px',
        photoset:'.photo-slideshow',
        photoWrap:'.photo-data',
        photo:'.pxu-photo'
      });
    });
  }

  function initUnnest($scope){
    if(!$.fn.unnest) return;

    var $posts = scopePosts($scope);
    if(!$posts.length) return;

    $posts.each(function(){
      var $post = $(this);
      if($post.data('acUnnestDone') === 1) return;

      $post.data('acUnnestDone', 1);

      $post.unnest({
        yourCaption:".caption",
        wrapName:".tumblr_parent",
        newCaptionUsername:false,
        originalPostCaptionUsername:false,
        tumblrAvatars:false,
        tumblrAvatarsName:".tumblr_avatar",
        usernameColon:false
      });
    });
  }

  function cleanupNPFMediaUrls($scope){
    $scope = ($scope && $scope.length) ? $scope : $(document);
    $scope.find('a[href]').each(function(){
      var $a = $(this);
      var hrefRaw = $a.attr('href') || '';
      var href = hrefRaw.toLowerCase();
      var txt = $.trim($a.text() || '');

      var isMedia =
        href.indexOf('64.media.tumblr.com/') !== -1 ||
        href.indexOf('va.media.tumblr.com/') !== -1 ||
        href.indexOf('media.tumblr.com/') !== -1;

      if(!isMedia) return;

      if(txt && ($.trim(hrefRaw) === txt || $.trim(href) === txt.toLowerCase()) && $a.children().length === 0){
        var $p = $a.closest('p');
        if($p.length && $.trim($p.text()) === txt) $p.remove();
        else $a.remove();
      }
    });
  }

  // Tags posts appropriately based on media content and moves footers structural placement
  function classifyAndMoveFooter($scope) {
    scopePosts($scope).each(function(){
      var $post = $(this);
      var isMediaPost = hasMedia($post);

      $post.toggleClass('ac-media-post', isMediaPost)
           .toggleClass('ac-text-post', !isMediaPost);

      var $footer = $post.find('.post-footer').first();
      if($footer.length) {
        $footer.appendTo($post);
      }
    });
  }

  function forceEager($scope){
    $scope = $scope && $scope.length ? $scope : $(document);
    $scope.find('img[loading="lazy"]').each(function(){
      try{ this.loading = 'eager'; }catch(e){}
      $(this).attr('loading','eager');
    });
    $scope.find('iframe[loading="lazy"]').each(function(){
      $(this).attr('loading','eager');
    });
  }

  function processPosts($scope){
    var $posts = scopePosts($scope);
    if(!$posts.length) return;

    forceEager($posts);

    safe(function(){ initPhotosets($posts); });
    safe(function(){ initUnnest($posts); });
    safe(function(){ cleanupNPFMediaUrls($posts); });
    safe(function(){ classifyAndMoveFooter($posts); });

    watchMediaLoads($posts);
  }

  function scanForNewPosts(){
    if(scanTimer) clearTimeout(scanTimer);

    scanTimer = setTimeout(function(){
      scanTimer = null;

      var $new = $container.children('.posts').filter(function(){
        return !$(this).data('acScanned');
      });

      if(!$new.length) return;

      $new.each(function(){
        $(this).data('acScanned', 1);
      });

      hidePosts($new);
      processPosts($new);

      if($.fn.imagesLoaded){
        $new.imagesLoaded(function(){
          showPosts($new);
          layoutPosts();
          runSettledLayouts();
        });
      } else {
        showPosts($new);
        layoutPosts();
        runSettledLayouts();
      }
    }, 90);
  }

  function getPostWidth(){
    var w = 0;
    $container.children('.posts').each(function(){
      var $p = $(this);
      if($p.hasClass('ac-prep')) return;

      var ow = Math.ceil($p.outerWidth(true) || 0);
      if(ow > w) w = ow;
    });
    if(w <= 0){
      $container.children('.posts').each(function(){
        var ow = Math.ceil($(this).outerWidth(true) || 0);
        if(ow > w) w = ow;
      });
    }

    if(w <= 0) w = 400; // Updated fallback default from 340 to your 400px width
    return w;
  }

  function getColumnCount(containerWidth, itemWidth){
    var cols = Math.max(1, Math.floor(containerWidth / itemWidth));
    if(cols > 3) cols = 3; // Updated ceiling from 2 to 3 columns
    return cols;
  }

  function layoutPosts(){
    var $items = $container.children('.posts');
    if(!$items.length) return;

    var containerWidth =
      Math.round($container.width()) ||
      Math.round($container.parent().width()) ||
      Math.round($win.width());

    var itemWidth = getPostWidth();
    var cols = getColumnCount(containerWidth, itemWidth);

    var usedWidth = cols * itemWidth;
    var leftOffset = Math.max(0, Math.floor((containerWidth - usedWidth) / 2));
    var heights = [];

    for(var i=0;i<cols;i++) heights[i] = 0;

    $container.css({
      position:'relative',
      height:''
    });

    $items.each(function(){
      var $item = $(this);

      $item.css({
        position:'absolute',
        display:'block'
      });

      var shortest = 0;
      for(var c=1;c<cols;c++){
        if(heights[c] < heights[shortest]) shortest = c;
      }

      var itemHeight =
        Math.ceil($item.outerHeight(true)) ||
        Math.ceil(this.getBoundingClientRect().height) ||
        1;

      var left = leftOffset + shortest * itemWidth;
      var top = heights[shortest];

      $item.css({
        left:left + 'px',
        top:top + 'px',
        zIndex:1
      });

      heights[shortest] += itemHeight;
    });

    var maxHeight = 0;
    for(var j=0;j<heights.length;j++){
      if(heights[j] > maxHeight) maxHeight = heights[j];
    }

    $container.css('height', Math.ceil(maxHeight) + 'px');
  }

  function requestLayout(){
    if(layoutTimer) clearTimeout(layoutTimer);
    layoutTimer = setTimeout(function(){
      layoutTimer = null;
      layoutPosts();
    }, 90);
  }

  function hidePosts($posts){
    if(!$posts || !$posts.length) return;
    $posts
      .removeClass('is-ready')
      .addClass('ac-prep')
      .css({
        visibility:'hidden',
        opacity:0,
        pointerEvents:'none',
        zIndex:-1
      });
  }

  function showPosts($posts){
    if(!$posts || !$posts.length) return;
    $posts
      .removeClass('ac-prep')
      .addClass('is-ready')
      .css({
        visibility:'',
        opacity:'',
        pointerEvents:'',
        zIndex:1
      });
  }

  function layoutAndReveal($posts){
    processPosts($posts);

    function reveal(){
      showPosts($posts);
      layoutPosts();
      setTimeout(function(){ layoutPosts(); }, 180);
      setTimeout(function(){ layoutPosts(); }, 700);
      setTimeout(function(){ layoutPosts(); }, 1400);
    }

    if($.fn.imagesLoaded){
      $posts.imagesLoaded(function(){
        reveal();
      });
    } else {
      reveal();
    }
  }

  function watchMediaLoads($items){
    if(!$items || !$items.length) return;
    $items.find('img').each(function(){
      if(this._acHoverWatchBound) return;
      this._acHoverWatchBound = true;

      this.addEventListener('load', requestLayout, false);
      this.addEventListener('error', requestLayout, false);
    });
    $items.find('iframe').each(function(){
      if(this._acHoverWatchBound) return;
      this._acHoverWatchBound = true;

      this.addEventListener('load', requestLayout, false);
    });
  }

  function runSettledLayouts(){
    var delays = [180, 500, 1000, 1800];
    for(var i=0;i<delays.length;i++){
      setTimeout(function(){
        layoutPosts();
      }, delays[i]);
    }
  }

  function bindLayoutEvents(){
    $win.off('.acMasonryWin');
    $win.on('scroll.acMasonryWin', throttle(function(){
      scanForNewPosts();
    }, 160));
    $win.on('resize.acMasonryWin', throttle(function(){
      requestLayout();
    }, 220));
  }

  function initMutationObserver(){
    if(!window.MutationObserver) return;

    if(mutationObserver){
      try{ mutationObserver.disconnect(); }catch(e){}
    }

    mutationObserver = new MutationObserver(function(mutations){
      var found = false;
      for(var i=0;i<mutations.length;i++){
        if(mutations[i].addedNodes && mutations[i].addedNodes.length){
          found = true;
          break;
        }
      }
      if(found) scanForNewPosts();
    });

    try{
      mutationObserver.observe($container[0], {
        childList:true,
        subtree:false
      });
    }catch(e){}
  }

  function initInfiniteScrollIfPresent(){
    if(!$.fn.infinitescroll) return;
    if(!document.getElementById('next')) return;
    if(!document.getElementById('pagination')) return;

    $container.infinitescroll({
      navSelector:'#pagination',
      nextSelector:'#next',
      itemSelector:'.posts',
      loading:{
        selector:'#infscr-loading',
        img:'',
        msgText:'',
        finishedMsg:''
      },
      bufferPx:1200,
      appendCallback:false
    }, function(newElements){
      var $new = $(newElements).filter('.posts');

      if(!$new.length){
        $new = $(newElements).find('.posts');
      }

      if(!$new.length) return;

      $new.each(function(){
        $(this).data('acScanned', 1);
      });

      $new
        .removeClass('is-ready')
        .addClass('ac-prep')
        .css({
          visibility:'hidden',
          opacity:0,
          pointerEvents:'none',
          display:'block',
          position:'absolute',
          left:'-99999px',
          top:'0',
          zIndex:-1
        });

      $container.append($new);

      forceEager($new);
      layoutAndReveal($new);
      runSettledLayouts();
    });
  }

  $(document).ready(function(){
    $container.css('position','relative');

    var $initial = $container.children('.posts');

    $initial.each(function(){
      $(this).data('acScanned', 1);
    });

    hidePosts($initial);

    bindLayoutEvents();
    initMutationObserver();

    forceEager($initial);
    layoutAndReveal($initial);
    initInfiniteScrollIfPresent();
    runSettledLayouts();

    setTimeout(function(){
      showPosts($initial);
      layoutPosts();
    }, 800);

    setTimeout(function(){
      showPosts($initial);
      layoutPosts();
    }, 1800);

    setTimeout(function(){
      showPosts($initial);
      layoutPosts();
    }, 3000);
  });

})(window.jQuery);
</script>
{/block:IndexPage}

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 1. Dropdown Toggle Matrix
  var trigger = document.getElementById('exploreDropdownBtn');
  var drawer = document.getElementById('exploreDrawer');
  
  if (trigger && drawer) {
    trigger.addEventListener('click', function(e) {
      e.preventDefault();
      var isOpen = drawer.classList.contains('is-open');
      if (isOpen) {
        drawer.classList.remove('is-open');
        trigger.classList.remove('is-active');
      } else {
        drawer.classList.add('is-open');
        trigger.classList.add('is-active');
      }
    });
  }

  // 2. Solidified Music Engine
  var audio = document.getElementById('acMiniAudio');
  var toggleBtn = document.getElementById('acMiniToggle');
  var nextBtn = document.getElementById('sbNext');
  var trackName = document.getElementById('sbTrackName');
  var trackArtist = document.getElementById('sbTrackArtist');
  var songs = document.querySelectorAll('#sbPlaylist .sb-song');
  
  if (!audio || !toggleBtn || !songs.length) return;
  
  var currentIdx = 0;
  var isInitialLoad = true;

  function loadTrack(index) {
    if (index >= songs.length || index < 0) return;
    
    songs.forEach(function(s) { s.classList.remove('is-active'); });
    
    var currentSong = songs[index];
    currentSong.classList.add('is-active');
    
    var targetSrc = currentSong.getAttribute('data-src');
    var targetTitle = currentSong.getAttribute('data-title') || "Unknown Track";
    var targetArtist = currentSong.getAttribute('data-artist') || "Unknown Artist";
    
    audio.src = targetSrc;
    trackName.textContent = targetTitle;
    trackArtist.textContent = targetArtist;
    
    // Do not trigger playback or modify text if it is the very first page load
    if (!isInitialLoad) {
      audio.load();
      audio.play().catch(function(e) { console.log("Playback engine paused/prevented."); });
    }
  }

  // Initialize track 01 natively
  loadTrack(currentIdx);
  // Set initial load to false safely AFTER initialization
  isInitialLoad = false;

  // Direct Button Toggle Control
  toggleBtn.addEventListener('click', function(e) {
    e.preventDefault();
    if (audio.paused || audio.ended) {
      audio.play().catch(function(err) {
        console.warn("Audio play blocked: ", err);
      });
    } else {
      audio.pause();
    }
  });

  // Skip Control
  if (nextBtn) {
    nextBtn.addEventListener('click', function(e) {
      e.preventDefault();
      currentIdx = (currentIdx + 1) % songs.length;
      loadTrack(currentIdx);
    });
  }

  // Primary Global Event Listeners (Handles ALL play/pause text switches smoothly)
  audio.addEventListener('play', function() { 
    toggleBtn.textContent = 'pause'; 
  });
  
  audio.addEventListener('pause', function() { 
    toggleBtn.textContent = 'play'; 
  });
  
  audio.addEventListener('ended', function() {
    // When song ends, seamlessly advance to next index
    currentIdx = (currentIdx + 1) % songs.length;
    loadTrack(currentIdx);
  });
});
</script>

