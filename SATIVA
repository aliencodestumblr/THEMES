<script>
// Toggle Explore Menu Engine
function toggleExploreMenu(e) {
  if(e) e.preventDefault();
  var drawer = document.getElementById('exploreDrawer');
  if (!drawer) return;
  
  if (drawer.style.maxHeight === '250px') {
    drawer.style.maxHeight = '0px';
  } else {
    drawer.style.maxHeight = '250px';
  }
}

// Modal Toggle Engine Routing Functions
function openAskModal(e) {
  if(e) e.preventDefault();
  var overlay = document.getElementById('askOverlay');
  if (overlay) overlay.classList.add('is-visible');
}

function closeAskModal(e) {
  if(e) e.preventDefault();
  var overlay = document.getElementById('askOverlay');
  if (overlay) overlay.classList.remove('is-visible');
}

document.addEventListener('DOMContentLoaded', function() {
  // Audio Handler Blueprint Execution
  var audio = document.getElementById('acMiniAudio');
  var toggleBtn = document.getElementById('acMiniToggle');
  var nextBtn = document.getElementById('sbNext');
  var trackName = document.getElementById('sbTrackName');
  var trackArtist = document.getElementById('sbTrackArtist');
  var songs = document.querySelectorAll('#sbPlaylist .sb-song');
  
  if (!audio || !toggleBtn || !songs.length) return;
  var currentIdx = 0;

  function loadTrack(index) {
    if (index >= songs.length || index < 0) return;
    songs.forEach(function(s) { s.classList.remove('is-active'); });
    var currentSong = songs[index];
    currentSong.classList.add('is-active');
    
    audio.src = currentSong.getAttribute('data-src');
    trackName.textContent = currentSong.getAttribute('data-title');
    trackArtist.textContent = currentSong.getAttribute('data-artist');
    audio.load();
  }

  loadTrack(currentIdx);

  toggleBtn.addEventListener('click', function(e) {
    e.preventDefault();
    if (audio.paused || audio.ended) {
      audio.play().then(function() {
        toggleBtn.textContent = 'pause';
      }).catch(function(err) { console.log(err); });
    } else {
      audio.pause();
      toggleBtn.textContent = 'play';
    }
  });

  if (nextBtn) {
    nextBtn.addEventListener('click', function(e) {
      e.preventDefault();
      currentIdx = (currentIdx + 1) % songs.length;
      loadTrack(currentIdx);
    });
  }

  audio.addEventListener('play', function() { toggleBtn.textContent = 'pause'; });
  audio.addEventListener('pause', function() { toggleBtn.textContent = 'play'; });
  audio.addEventListener('ended', function() {
    currentIdx = (currentIdx + 1) % songs.length;
    loadTrack(currentIdx);
  });
});
</script>

