<script>
document.addEventListener('DOMContentLoaded', function() {
  /* ================= MULTI-TRACK PLAYER SCRIPT ================= */
  const audio = document.getElementById('acMiniAudio');
  const toggleBtn = document.getElementById('acMiniToggle');
  const prevBtn = document.getElementById('acMiniPrev');
  const nextBtn = document.getElementById('acMiniNext');
  const trackName = document.getElementById('sbTrackName');
  const trackArtist = document.getElementById('sbTrackArtist');
  const playlistNodes = document.querySelectorAll('#sbPlaylist .sb-song');

  const playIcon = '<svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
  const pauseIcon = '<svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';

  // Helper function to extract clean plain text from Tumblr tags
  function cleanTumblrText(str) {
    if (!str) return '';
    const temp = document.createElement('div');
    temp.innerHTML = str;
    return (temp.textContent || temp.innerText || str).trim();
  }

  // Build clean track list
  let tracks = [];
  playlistNodes.forEach(node => {
    let rawSrc = node.getAttribute('data-src') || '';
    let cleanSrc = cleanTumblrText(rawSrc);

    // If Dropbox link, convert to direct audio stream link automatically
    if (cleanSrc.includes('dropbox.com')) {
      cleanSrc = cleanSrc.replace('www.dropbox.com', 'dl.dropboxusercontent.com').replace('?dl=0', '');
    }

    if (cleanSrc && cleanSrc !== '' && !cleanSrc.includes('{text:')) {
      tracks.push({
        src: cleanSrc,
        title: cleanTumblrText(node.getAttribute('data-title')) || 'Untitled Track',
        artist: cleanTumblrText(node.getAttribute('data-artist')) || 'Unknown Artist'
      });
    }
  });

  let currentTrackIndex = 0;

  function loadTrack(index) {
    if (tracks.length === 0) return;

    currentTrackIndex = (index + tracks.length) % tracks.length;
    const track = tracks[currentTrackIndex];

    audio.src = track.src;
    if (trackName) trackName.textContent = track.title;
    if (trackArtist) trackArtist.textContent = track.artist;
  }

  if (tracks.length > 0 && audio && toggleBtn) {
    // Initial load of track 1
    loadTrack(0);

    // Explicit Audio Event Listeners for Icon Toggling
    audio.addEventListener('play', function() {
      toggleBtn.innerHTML = pauseIcon;
    });

    audio.addEventListener('pause', function() {
      toggleBtn.innerHTML = playIcon;
    });

    audio.addEventListener('ended', function() {
      if (tracks.length > 1) {
        loadTrack(currentTrackIndex + 1);
        audio.play().catch(e => console.error("Auto-next error:", e));
      } else {
        toggleBtn.innerHTML = playIcon;
      }
    });

    // Play/Pause Click Handler
    toggleBtn.addEventListener('click', function(e) {
      e.preventDefault();

      if (!audio.src) {
        alert("Audio source is missing!");
        return;
      }

      if (audio.paused) {
        const playPromise = audio.play();
        if (playPromise !== undefined) {
          playPromise.catch(err => {
            console.error("Playback Error:", err);
            alert("Unable to play track! Check that your audio link is a direct MP3 file (e.g. Catbox, Dropbox, Discord, or Google Drive direct link).");
          });
        }
      } else {
        audio.pause();
      }
    });

    // Previous Button
    if (prevBtn) {
      prevBtn.addEventListener('click', function(e) {
        e.preventDefault();
        const wasPlaying = !audio.paused;
        loadTrack(currentTrackIndex - 1);
        if (wasPlaying) audio.play();
      });
    }

    // Next Button
    if (nextBtn) {
      nextBtn.addEventListener('click', function(e) {
        e.preventDefault();
        const wasPlaying = !audio.paused;
        loadTrack(currentTrackIndex + 1);
        if (wasPlaying) audio.play();
      });
    }

  } else if (toggleBtn) {
    toggleBtn.addEventListener('click', function() {
      alert("No audio found! Make sure you entered a direct MP3 URL in your Tumblr theme options.");
    });
  }

  /* ================= ASK MODAL LOGIC ================= */
  const openAskBtn = document.getElementById('openAskPopup');
  const closeAskBtn = document.getElementById('closeAskModal');
  const askOverlay = document.getElementById('askModalOverlay');

  if (openAskBtn && askOverlay) {
    openAskBtn.addEventListener('click', function(e) {
      e.preventDefault();
      askOverlay.classList.add('is-active');
      askOverlay.setAttribute('aria-hidden', 'false');
    });
  }

  if (closeAskBtn && askOverlay) {
    closeAskBtn.addEventListener('click', function() {
      askOverlay.classList.remove('is-active');
      askOverlay.setAttribute('aria-hidden', 'true');
    });
  }

  if (askOverlay) {
    askOverlay.addEventListener('click', function(e) {
      if (e.target === askOverlay) {
        askOverlay.classList.remove('is-active');
        askOverlay.setAttribute('aria-hidden', 'true');
      }
    });
  }
});
</script>

